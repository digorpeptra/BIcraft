             [4, "North", "Web", 110, 9], [4, "South", "Shop", 70, 6]]}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Amount Total",
    "expression": "SUM(Sales[Amount])", "format_string": "#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Units Total",
    "expression": "SUM(Sales[Units])", "format_string": "#,0"}},
