[
  {"command": "model.new", "params": {"name": "Star"}},
  {"command": "table.enter_data", "params": {"name": "Product",
    "columns": [{"name": "ProductKey", "type": "whole"}, {"name": "Product", "type": "text"},
                {"name": "Category", "type": "text"}],
    "rows": [[1, "Apples", "Fruit"], [2, "Pears", "Fruit"], [3, "Carrots", "Vegetables"],
             [4, "Leeks", "Vegetables"]]}},
  {"command": "table.enter_data", "params": {"name": "Customer",
    "columns": [{"name": "CustomerKey", "type": "whole"}, {"name": "Customer", "type": "text"},
                {"name": "Country", "type": "text"}],
    "rows": [[10, "Alder", "France"], [11, "Birch", "Belgium"], [12, "Cedar", "France"]]}},
  {"command": "table.enter_data", "params": {"name": "Date",
    "columns": [{"name": "Date", "type": "date"}, {"name": "Year", "type": "whole"},
                {"name": "Month", "type": "whole"}],
    "rows": [["2026-01-01", 2026, 1], ["2026-01-15", 2026, 1], ["2026-02-01", 2026, 2],
             ["2026-02-15", 2026, 2], ["2026-03-01", 2026, 3]]}},
  {"command": "table.enter_data", "params": {"name": "Sales",
    "columns": [{"name": "OrderDate", "type": "date"}, {"name": "ShipDate", "type": "date"},
                {"name": "ProductKey", "type": "whole"}, {"name": "CustomerKey", "type": "whole"},
                {"name": "Amount", "type": "number"}],
    "rows": [["2026-01-01", "2026-01-15", 1, 10, 100], ["2026-01-15", "2026-02-01", 2, 11, 50],
             ["2026-02-01", "2026-02-15", 3, 12, 75.5], ["2026-02-15", "2026-03-01", 4, 10, 20],
             ["2026-03-01", "2026-03-01", 1, 11, 130]]}},
  {"command": "relationship.add", "params": {"name": "Sales_Product",
    "from": "Sales[ProductKey]", "to": "Product[ProductKey]"}},
  {"command": "relationship.add", "params": {"name": "Sales_Customer",
    "from": "Sales[CustomerKey]", "to": "Customer[CustomerKey]", "cross_filter": "both"}},
  {"command": "relationship.add", "params": {"name": "Sales_OrderDate",
    "from": "Sales[OrderDate]", "to": "Date[Date]"}},
  {"command": "relationship.add", "params": {"name": "Sales_ShipDate",
    "from": "Sales[ShipDate]", "to": "Date[Date]", "active": false}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue",
    "expression": "SUM(Sales[Amount])", "format_string": "#,0.00"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue by Ship Date",
    "expression": "CALCULATE([Revenue], USERELATIONSHIP(Sales[ShipDate], 'Date'[Date]))",
    "format_string": "#,0.00"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Customers",
    "expression": "DISTINCTCOUNT(Sales[CustomerKey])"}},
  {"command": "report.new", "params": {}},
  {"command": "page.rename", "params": {"page": "Page 1", "display_name": "Star"}},
  {"command": "visual.add", "params": {"page": "Star", "visual_type": "tableEx",
    "x": 40, "y": 40, "width": 500, "height": 300,
    "fields": [{"role": "Values", "field": "Product[Category]"}, {"role": "Values", "field": "[Revenue]"},
               {"role": "Values", "field": "[Revenue by Ship Date]"}]}},
  {"command": "visual.add", "params": {"page": "Star", "visual_type": "clusteredBarChart",
    "x": 580, "y": 40, "width": 500, "height": 300,
    "fields": [{"role": "Category", "field": "Customer[Country]"}, {"role": "Y", "field": "[Customers]"}]}},
  {"command": "file.save_as", "params": {"path": "star.pbix"}}
]
