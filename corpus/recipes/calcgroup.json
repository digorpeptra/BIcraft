[
  {"command": "model.new", "params": {"name": "CalcGroup"}},
  {"command": "table.enter_data", "params": {"name": "Date",
    "columns": [{"name": "Date", "type": "date"}, {"name": "Year", "type": "whole"}],
    "rows": [["2025-01-10", 2025], ["2025-06-10", 2025], ["2025-11-10", 2025],
             ["2026-01-10", 2026], ["2026-06-10", 2026], ["2026-11-10", 2026]]}},
  {"command": "table.enter_data", "params": {"name": "Sales",
    "columns": [{"name": "Date", "type": "date"}, {"name": "Amount", "type": "number"}],
    "rows": [["2025-01-10", 10], ["2025-06-10", 20], ["2025-11-10", 30],
             ["2026-01-10", 15], ["2026-06-10", 25], ["2026-11-10", 35]]}},
  {"command": "relationship.add", "params": {"name": "Sales_Date",
    "from": "Sales[Date]", "to": "Date[Date]"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Sales Amount",
    "expression": "SUM(Sales[Amount])", "format_string": "#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Order Count",
    "expression": "COUNTROWS(Sales)"}},
  {"command": "calculation_group.add", "params": {"name": "Time Intelligence", "column": "Period"}},
  {"command": "calculation_item.add", "params": {"group": "Time Intelligence", "name": "Current",
    "expression": "SELECTEDMEASURE()"}},
  {"command": "calculation_item.add", "params": {"group": "Time Intelligence", "name": "YTD",
    "expression": "CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))"}},
  {"command": "calculation_item.add", "params": {"group": "Time Intelligence", "name": "Prior Year",
    "expression": "CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date]))"}},
  {"command": "calculation_item.add", "params": {"group": "Time Intelligence", "name": "YoY %",
    "expression": "VAR cur = SELECTEDMEASURE() VAR prev = CALCULATE(SELECTEDMEASURE(), SAMEPERIODLASTYEAR('Date'[Date])) RETURN DIVIDE(cur - prev, prev)",
    "format_string_expression": "\"0.0%\""}},
  {"command": "report.new", "params": {}},
  {"command": "page.rename", "params": {"page": "Page 1", "display_name": "Periods"}},
  {"command": "visual.add", "params": {"page": "Periods", "visual_type": "pivotTable",
    "x": 40, "y": 40, "width": 600, "height": 300,
    "fields": [{"role": "Rows", "field": "Date[Year]"}, {"role": "Columns", "field": "Time Intelligence[Period]"},
               {"role": "Values", "field": "[Sales Amount]"}]}},
  {"command": "file.save_as", "params": {"path": "calcgroup.pbix"}}
]
