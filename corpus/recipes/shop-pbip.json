[
  {"command": "model.new", "params": {"name": "Shop"}},
  {"command": "table.enter_data", "params": {"name": "Product",
    "columns": [{"name": "ProductKey", "type": "whole"}, {"name": "Product", "type": "text"},
                {"name": "Price", "type": "number"}],
    "rows": [[1, "Mug", 8.5], [2, "Plate", 12], [3, "Bowl", 9.75]]}},
  {"command": "table.enter_data", "params": {"name": "Orders",
    "columns": [{"name": "OrderId", "type": "whole"}, {"name": "ProductKey", "type": "whole"},
                {"name": "Quantity", "type": "whole"}],
    "rows": [[1001, 1, 2], [1002, 2, 1], [1003, 3, 4], [1004, 1, 1], [1005, 2, 3]]}},
  {"command": "column.add", "params": {"table": "Orders", "name": "Line Amount",
    "expression": "Orders[Quantity] * RELATED(Product[Price])", "data_type": "double"}},
  {"command": "relationship.add", "params": {"name": "Orders_Product",
    "from": "Orders[ProductKey]", "to": "Product[ProductKey]"}},
  {"command": "measure.add", "params": {"table": "Orders", "name": "Order Amount",
    "expression": "SUM(Orders[Line Amount])", "format_string": "#,0.00", "display_folder": "Sales"}},
  {"command": "measure.add", "params": {"table": "Orders", "name": "Orders",
    "expression": "DISTINCTCOUNT(Orders[OrderId])", "display_folder": "Sales"}},
  {"command": "report.new", "params": {}},
  {"command": "page.rename", "params": {"page": "Page 1", "display_name": "Shop"}},
  {"command": "visual.add", "params": {"page": "Shop", "visual_type": "clusteredColumnChart",
    "x": 40, "y": 40, "width": 600, "height": 360,
    "fields": [{"role": "Category", "field": "Product[Product]"}, {"role": "Y", "field": "[Order Amount]"}]}},
  {"command": "visual.add", "params": {"page": "Shop", "visual_type": "card",
    "x": 680, "y": 40, "width": 300, "height": 160, "fields": [{"role": "Values", "field": "[Orders]"}]}},
  {"command": "project.new", "params": {"dir": "shop", "name": "Shop"}}
]
