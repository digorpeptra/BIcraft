[
  {"command": "model.new", "params": {"name": "Calculated"}},
  {"command": "table.enter_data", "params": {"name": "Sales",
    "columns": [{"name": "Date", "type": "date"}, {"name": "Amount", "type": "number"},
                {"name": "Cost", "type": "number"}],
    "rows": [["2026-01-03", 120, 70], ["2026-01-20", 80, 60], ["2026-02-11", 210, 120],
             ["2026-02-27", 45, 40], ["2026-03-09", 160, 90], ["2026-03-30", 30, 25]]}},
  {"command": "table.add", "params": {"name": "Calendar",
    "partition": {"source_type": "calculated",
                  "expression": "CALENDAR(DATE(2026, 1, 1), DATE(2026, 3, 31))"}}},
  {"command": "column.add", "params": {"table": "Calendar", "name": "Date",
    "source_column": "[Date]", "data_type": "dateTime"}},
  {"command": "column.add", "params": {"table": "Calendar", "name": "Month",
    "expression": "MONTH('Calendar'[Date])", "data_type": "int64"}},
  {"command": "column.add", "params": {"table": "Sales", "name": "Margin",
    "expression": "Sales[Amount] - Sales[Cost]", "data_type": "double"}},
  {"command": "column.add", "params": {"table": "Sales", "name": "Band",
    "expression": "IF(Sales[Amount] >= 100, \"High\", \"Low\")", "data_type": "string"}},
  {"command": "relationship.add", "params": {"name": "Sales_Calendar",
    "from": "Sales[Date]", "to": "Calendar[Date]"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Total Margin",
    "expression": "SUM(Sales[Margin])", "format_string": "#,0.00"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Margin %",
    "expression": "DIVIDE([Total Margin], SUM(Sales[Amount]))", "format_string": "0.0%"}},
  {"command": "report.new", "params": {}},
  {"command": "page.rename", "params": {"page": "Page 1", "display_name": "Margins"}},
  {"command": "visual.add", "params": {"page": "Margins", "visual_type": "pivotTable",
    "x": 40, "y": 40, "width": 500, "height": 300,
    "fields": [{"role": "Rows", "field": "Calendar[Month]"}, {"role": "Columns", "field": "Sales[Band]"},
               {"role": "Values", "field": "[Total Margin]"}]}},
  {"command": "visual.add", "params": {"page": "Margins", "visual_type": "lineChart",
    "x": 580, "y": 40, "width": 500, "height": 300,
    "fields": [{"role": "Category", "field": "Calendar[Month]"}, {"role": "Y", "field": "[Margin %]"}]}},
  {"command": "file.save_as", "params": {"path": "calculated.pbix"}}
]
