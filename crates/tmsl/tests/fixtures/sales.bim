            "name": "Amount",
            "dataType": "decimal",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "a1b2c3d4-0001-4000-8000-000000000005",
            "sourceColumn": "Amount",
            "summarizeBy": "sum"
          },
          {
            "name": "Amount With Tax",
            "dataType": "double",
            "expression": [
              "",
              "VAR rate = 0.2",
              "RETURN",
              "    Sales[Amount] * (1 + rate)"
            ],
            "isDataTypeInferred": true,
            "lineageTag": "a1b2c3d4-0001-4000-8000-000000000006",
            "summarizeBy": "sum",
            "type": "calculated"
          },
          {
            "name": "Is Big",
            "dataType": "boolean",
            "expression": "Sales[Amount] > 1000",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "isDataTypeInferred": true,
            "lineageTag": "a1b2c3d4-0001-4000-8000-000000000007",
            "summarizeBy": "none",
            "type": "calculated"
          }
        ],
        "lineageTag": "a1b2c3d4-0000-4000-8000-000000000000",
        "measures": [
          {
            "name": "Total Sales",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ],
            "displayFolder": "Revenue",
            "expression": "SUM(Sales[Amount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "lineageTag": "b1b2c3d4-0001-4000-8000-000000000001"
          },
          {
            "name": "Sales YoY %",
            "description": "Year-over-year growth of Total Sales.",
            "expression": [
              "",
              "VAR cur = [Total Sales]",
              "VAR prev = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))",
              "RETURN",
              "    DIVIDE(cur - prev, prev)"
            ],
            "formatStringDefinition": {
              "expression": "IF(ABS([Sales YoY %]) < 0.01, \"0.00%\", \"0.0%\")"
            },
            "lineageTag": "b1b2c3d4-0001-4000-8000-000000000002"
          },
          {
            "name": "Hidden Helper",
            "dataType": "int64",
            "expression": "COUNTROWS(Sales)",
            "isHidden": true,
            "lineageTag": "b1b2c3d4-0001-4000-8000-000000000003"
          }
        ],
        "partitions": [
          {
            "name": "Sales-4d6f8a0c",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(SourceFolder & \"\\sales.csv\"), [Delimiter=\",\", Encoding=65001]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Amount\", Currency.Type}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ],
