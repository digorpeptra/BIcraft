        "lineageTag": "fbec260b-fc54-43ac-ab77-2af69a14a128",
        "measures": [
          {
            "name": "Total Amount",
            "expression": "SUM(Sales[Amount])",
            "lineageTag": "d3cd1440-fb75-4798-9c9c-664b8b9ddb7f"
          },
          {
            "name": "Units",
            "expression": "SUM(Sales[Qty])",
            "lineageTag": "b029839f-ff2f-445c-9007-70368e7142bd"
          },
          {
            "name": "Lines",
            "expression": "COUNTROWS(Sales)",
            "lineageTag": "be61a71f-76ff-4bff-90dc-c448e63bfefb"
          },
          {
            "name": "All Products",
            "expression": "CALCULATE([Total Amount], ALL(Product))",
            "lineageTag": "6a6654c5-d923-4fb7-bb60-81490d519d2b"
          },
          {
            "name": "Red Keep",
            "expression": "CALCULATE([Total Amount], KEEPFILTERS(Product[Color] = \"Red\"))",
            "lineageTag": "09e56a5b-031a-400c-bb18-756b47ad75a8"
          },
          {
            "name": "Red Replace",
            "expression": "CALCULATE([Total Amount], Product[Color] = \"Red\")",
            "lineageTag": "16aee897-275d-42a7-9b74-d1e34fb46da8"
          },
          {
            "name": "Share Selected",
            "expression": "DIVIDE([Total Amount], CALCULATE([Total Amount], ALLSELECTED(Product)))",
            "lineageTag": "94eb3db3-498f-42a8-b55c-0c35418cc4c6"
          },
          {
            "name": "Shipped Amount",
            "expression": "CALCULATE([Total Amount], USERELATIONSHIP(Sales[ShipDate], 'Date'[Date]))",
            "lineageTag": "2261fd62-632f-43a3-875a-73bd2eeeae62"
          },
          {
            "name": "Store Count",
            "expression": "COUNTROWS(Store)",
            "lineageTag": "8a4564db-20c0-4f0c-adb8-c5b9aa2245b4"
          },
          {
            "name": "Product Count",
            "expression": "COUNTROWS(Product)",
            "lineageTag": "665905ab-6b0d-4de2-8550-e91d8d5cc7ca"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "source": {
              "expression": "SELECTCOLUMNS(GENERATESERIES(1, 240), \"SalesKey\", [Value], \"ProductKey\", MOD([Value] * 5, 6) + 1, \"StoreKey\", MOD(MOD([Value] * 5, 6) + MOD(INT([Value] / 7), 2), 4) + 1, \"Date\", DATE(2025, 1, 1) + MOD([Value] * 37, 700), \"ShipDate\", DATE(2025, 1, 1) + MOD([Value] * 37, 700) + MOD([Value], 20), \"Qty\", MOD([Value], 5) + 1, \"Amount\", (MOD([Value] * 13, 41) + 10) * (MOD([Value], 5) + 1))",
              "type": "calculated"
            }
          }
        ]
      },
