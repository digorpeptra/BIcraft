table Calendar
	lineageTag: 0d6b1f7c-0000-4000-8000-000000000010
	dataCategory: Time

	column Date
		isKey
		formatString: Long Date
		lineageTag: 0d6b1f7c-0000-4000-8000-000000000011
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation UnderlyingDateTimeDataType = Date

	column Year = YEAR([Date])
		dataType: int64
		formatString: 0
		lineageTag: 0d6b1f7c-0000-4000-8000-000000000012
		summarizeBy: none

	column 'Month Number' = MONTH([Date])
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0d6b1f7c-0000-4000-8000-000000000013
		summarizeBy: none

	column 'Month Name' = FORMAT([Date], "MMMM")
		dataType: string
		lineageTag: 0d6b1f7c-0000-4000-8000-000000000014
		summarizeBy: none
		sortByColumn: 'Month Number'

	/// Year then month.
	hierarchy 'Calendar Hierarchy'
		lineageTag: 0d6b1f7c-0000-4000-8000-000000000015

		level Year
			lineageTag: 0d6b1f7c-0000-4000-8000-000000000016
			column: Year

		level Month
			lineageTag: 0d6b1f7c-0000-4000-8000-000000000017
			column: 'Month Name'

	partition Calendar = calculated
		mode: import
		source = CALENDARAUTO()

