/// Synthetic sales model
/// used by bicraft tests.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Staging

	annotation PBI_QueryGroupOrder = 0

/// Connection settings.
queryGroup Parameters

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Server Name","Sales Staging","Order Lines","Product"]

annotation PBIDesktopVersion = 2.158.1304.0 (26.09)

ref table 'Order Lines'
ref table Calendar
ref table Product
ref table 'Time Intelligence'
ref table '2024 Targets'
ref table 'Sales.Archive'

ref role 'Sales Reader'
ref role Admins

ref perspective 'Sales View'

ref cultureInfo en-US
ref cultureInfo fr-FR

