/// Sales table
table Sales
	lineageTag: 11111111-1111-4111-8111-111111111111

	defaultDetailRowsDefinition = SELECTCOLUMNS(Sales, "Id", Sales[Id])

	measure Total = SUM(Sales[Amount])
		formatString: 0.00

		/// kpi desc
		kpi
			targetDescription: target desc
			targetExpression = 100
			targetFormatString: 0
			statusGraphic: Three Circles Colored
			statusDescription: status desc
			statusExpression = IF([Total] > 10, 1, -1)
			trendGraphic: Standard Arrow
			trendDescription: trend desc
			trendExpression = 1

			extendedProperty KpiExt = e-KpiExt

			annotation KpiNote = k1

		detailRowsDefinition = SELECTCOLUMNS(Sales, "Amount", Sales[Amount])

		changedProperty = Name

		annotation MeasureNote = me1

	measure Dyn = SUM(Sales[Amount])
		displayFolder: Folder

		formatStringDefinition = "0.0"

	column Id
		isNameInferred
		sourceColumn: [Id]

		extendedProperty ColStr = s

		annotation ColNote = c1

	column Amount
		isNameInferred
		sourceColumn: [Amount]

	column Region
		isNameInferred
		sourceColumn: [Region]

	column City
		isNameInferred
		sourceColumn: [City]

	column Double = Sales[Amount] * 2
		displayFolder: Calc

	/// geo
	hierarchy Geo
		displayFolder: H
		hideMembers: hideBlankMembers

		level Region
			column: Region

			extendedProperty LevelExt = e-LevelExt

			annotation LevelNote = l1

		level City
			column: City

		extendedProperty HierExt = e-HierExt

		annotation HierNote = h1

	partition Sales = calculated
		source = DATATABLE("Id", INTEGER, "Amount", DOUBLE, "Region", STRING, "City", STRING, {{1, 10.5, "North", "Oslo"}, {2, 20, "South", "Rome"}})

	/// cal
	calendar Cal
		lineageTag: 44444444-4444-4444-8444-444444444444

		calendarColumnGroup = year
			primaryColumn: Id

		calendarColumnGroup = monthOfYear
			primaryColumn: Region
			associatedColumn: City

		calendarColumnGroup
			column: Amount

	annotation TableNote = t1

