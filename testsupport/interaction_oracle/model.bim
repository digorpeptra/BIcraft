{
 "name": "Interactions",
 "compatibilityLevel": 1567,
 "model": {
  "culture": "en-US",
  "tables": [
   {
    "name": "Product",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "ProductKey",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[ProductKey]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Product",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Product]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Category",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Category]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Color",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Color]"
     }
    ],
    "partitions": [
     {
      "name": "Product",
      "source": {
       "type": "calculated",
       "expression": "DATATABLE(\"ProductKey\", INTEGER, \"Product\", STRING, \"Category\", STRING, \"Color\", STRING, {{1, \"Bike\", \"Wheels\", \"Red\"}, {2, \"Ball\", \"Toys\", \"Blue\"}, {3, \"Car\", \"Wheels\", \"Red\"}, {4, \"Kite\", \"Toys\", \"Green\"}, {5, \"Helmet\", \"Gear\", \"Blue\"}, {6, \"Gloves\", \"Gear\", \"Red\"}})"
      }
     }
    ]
   },
   {
    "name": "Store",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "StoreKey",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[StoreKey]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Store",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Store]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Region",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Region]"
     }
    ],
    "partitions": [
     {
      "name": "Store",
      "source": {
       "type": "calculated",
       "expression": "DATATABLE(\"StoreKey\", INTEGER, \"Store\", STRING, \"Region\", STRING, {{1, \"Paris\", \"North\"}, {2, \"Lyon\", \"South\"}, {3, \"Nice\", \"South\"}, {4, \"Lille\", \"North\"}})"
      }
     }
    ]
   },
   {
    "name": "Date",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "Date",
      "dataType": "dateTime",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Date]",
      "isKey": true,
      "formatString": "yyyy-MM-dd"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Year",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Year]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Month",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Month]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Quarter",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Quarter]"
     }
    ],
    "partitions": [
     {
      "name": "Date",
      "source": {
       "type": "calculated",
       "expression": "ADDCOLUMNS(CALENDAR(DATE(2025, 1, 1), DATE(2026, 12, 31)), \"Year\", YEAR([Date]), \"Month\", MONTH([Date]), \"Quarter\", \"Q\" & QUARTER([Date]))"
      }
     }
    ],
    "dataCategory": "Time"
   },
   {
    "name": "Sales",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "SalesKey",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[SalesKey]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "ProductKey",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[ProductKey]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "StoreKey",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[StoreKey]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Date",
      "dataType": "dateTime",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Date]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "ShipDate",
      "dataType": "dateTime",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[ShipDate]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Qty",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Qty]"
     },
     {
      "type": "calculatedTableColumn",
      "name": "Amount",
      "dataType": "int64",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Amount]"
     }
    ],
    "partitions": [
     {
      "name": "Sales",
      "source": {
       "type": "calculated",
       "expression": "SELECTCOLUMNS(GENERATESERIES(1, 240), \"SalesKey\", [Value], \"ProductKey\", MOD([Value] * 5, 6) + 1, \"StoreKey\", MOD(MOD([Value] * 5, 6) + MOD(INT([Value] / 7), 2), 4) + 1, \"Date\", DATE(2025, 1, 1) + MOD([Value] * 37, 700), \"ShipDate\", DATE(2025, 1, 1) + MOD([Value] * 37, 700) + MOD([Value], 20), \"Qty\", MOD([Value], 5) + 1, \"Amount\", (MOD([Value] * 13, 41) + 10) * (MOD([Value], 5) + 1))"
      }
     }
    ],
    "measures": [
     {
      "name": "Total Amount",
      "expression": "SUM(Sales[Amount])"
     },
     {
      "name": "Units",
      "expression": "SUM(Sales[Qty])"
     },
     {
      "name": "Lines",
      "expression": "COUNTROWS(Sales)"
     },
     {
      "name": "All Products",
      "expression": "CALCULATE([Total Amount], ALL(Product))"
     },
     {
      "name": "Red Keep",
      "expression": "CALCULATE([Total Amount], KEEPFILTERS(Product[Color] = \"Red\"))"
     },
     {
      "name": "Red Replace",
      "expression": "CALCULATE([Total Amount], Product[Color] = \"Red\")"
     },
     {
      "name": "Share Selected",
      "expression": "DIVIDE([Total Amount], CALCULATE([Total Amount], ALLSELECTED(Product)))"
     },
     {
      "name": "Shipped Amount",
      "expression": "CALCULATE([Total Amount], USERELATIONSHIP(Sales[ShipDate], 'Date'[Date]))"
     },
     {
      "name": "Store Count",
      "expression": "COUNTROWS(Store)"
     },
     {
      "name": "Product Count",
      "expression": "COUNTROWS(Product)"
     }
    ]
   },
   {
    "name": "Tag",
    "columns": [
     {
      "type": "calculatedTableColumn",
      "name": "Page",
      "dataType": "string",
      "isNameInferred": true,
      "isDataTypeInferred": true,
      "sourceColumn": "[Page]"
     }
    ],
    "partitions": [
     {
      "name": "Tag",
      "source": {
       "type": "calculated",
       "expression": "DATATABLE(\"Page\", STRING, {{\"I00\"}, {\"I01\"}, {\"I02\"}, {\"I03\"}, {\"I04\"}, {\"I05\"}, {\"I06\"}, {\"I07\"}, {\"I08\"}, {\"I09\"}, {\"I10\"}, {\"I11\"}, {\"I12\"}, {\"I13\"}, {\"I14\"}, {\"I15\"}, {\"I16\"}, {\"I17\"}, {\"I18\"}, {\"I19\"}, {\"I20\"}, {\"I21\"}, {\"I22\"}, {\"I23\"}, {\"I24\"}, {\"I25\"}, {\"I26\"}, {\"I27\"}, {\"I28\"}})"
      }
     }
    ]
   }
  ],
  "relationships": [
   {
    "name": "Sales_Product",
    "fromTable": "Sales",
    "fromColumn": "ProductKey",
    "toTable": "Product",
    "toColumn": "ProductKey"
   },
   {
    "name": "Sales_Store",
    "fromTable": "Sales",
    "fromColumn": "StoreKey",
    "toTable": "Store",
    "toColumn": "StoreKey",
    "crossFilteringBehavior": "bothDirections"
   },
   {
    "name": "Sales_Date",
    "fromTable": "Sales",
    "fromColumn": "Date",
    "toTable": "Date",
    "toColumn": "Date"
   },
   {
    "name": "Sales_ShipDate",
    "fromTable": "Sales",
    "fromColumn": "ShipDate",
    "toTable": "Date",
    "toColumn": "Date",
    "isActive": false
   }
  ],
  "annotations": [
   {
    "name": "__PBI_TimeIntelligenceEnabled",
    "value": "0"
   }
  ]
 }
}