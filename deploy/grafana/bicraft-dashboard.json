{
  "title": "BIcraft serve",
  "uid": "bicraft-serve",
  "description": "bicraft serve: requests, command latency, queue, memory against the limit, evictions, spill, aggregation builds, drain (docs/kubernetes.md, Observability). No model data is exported.",
  "tags": ["bicraft", "mcp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Pod",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(bicraft_build_info, instance)", "refId": "instance"},
        "definition": "label_values(bicraft_build_info, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Draining",
      "description": "1 while the server drains after SIGTERM: new requests get 503, nothing is saved implicitly.",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "max(bicraft_draining{instance=~\"$instance\"})"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {"0": {"text": "serving", "color": "green"}, "1": {"text": "draining", "color": "orange"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open workspaces",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum(bicraft_workspaces_open{instance=~\"$instance\"})"}],
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "In flight / queued",
      "description": "Requests in progress, and tool calls waiting for their workspace session.",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(bicraft_http_requests_in_flight{instance=~\"$instance\"})", "legendFormat": "in flight"},
        {"refId": "B", "expr": "sum(bicraft_tool_calls_queued{instance=~\"$instance\"})", "legendFormat": "queued"}
      ],
      "options": {"graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Memory used / limit",
      "description": "Reserved bytes against BICRAFT_MEMORY_LIMIT (no value: no limit set).",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "max(bicraft_memory_reserved_bytes{instance=~\"$instance\"} / (bicraft_memory_limit_bytes{instance=~\"$instance\"} > 0))"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.75}, {"color": "red", "value": 0.95}]}
        },
        "overrides": []
      },
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Queue rejections (1 h)",
      "description": "Tool calls answered 503 because the workspace queue or the workspace table was full.",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum(increase(bicraft_queue_rejections_total{instance=~\"$instance\"}[1h]))"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Version",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "count by (version) (bicraft_build_info{instance=~\"$instance\"})", "legendFormat": "{{version}}", "instant": true}],
      "options": {"textMode": "name", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests per second by route and status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (route, code) (rate(bicraft_http_requests_total{instance=~\"$instance\", route!~\"healthz|readyz\"}[$__rate_interval]))", "legendFormat": "{{route}} {{code}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request latency p50 / p95 by route",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le, route) (rate(bicraft_http_request_duration_seconds_bucket{instance=~\"$instance\", route=~\"mcp|files\"}[$__rate_interval])))", "legendFormat": "p50 {{route}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(bicraft_http_request_duration_seconds_bucket{instance=~\"$instance\", route=~\"mcp|files\"}[$__rate_interval])))", "legendFormat": "p95 {{route}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Command latency p50 / p95",
      "description": "Tool call durations by engine command id, queue wait excluded. file.open and file.save are the open and save durations.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le, command) (rate(bicraft_command_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p50 {{command}}"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, command) (rate(bicraft_command_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{command}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Commands per second by outcome",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum by (command, outcome) (rate(bicraft_commands_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{command}} {{outcome}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory vs limit",
      "description": "Reserved bytes by class against BICRAFT_MEMORY_LIMIT, and the resident memory of the process.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum by (class) (bicraft_memory_reserved_class_bytes{instance=~\"$instance\"})", "legendFormat": "reserved {{class}}"},
        {"refId": "B", "expr": "max(bicraft_memory_limit_bytes{instance=~\"$instance\"} > 0)", "legendFormat": "limit"},
        {"refId": "C", "expr": "max(bicraft_process_resident_bytes{instance=~\"$instance\"})", "legendFormat": "resident"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "bytes", "custom": {"stacking": {"mode": "none"}}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "limit"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Evictions and refusals per minute",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(bicraft_memory_evictions_total{instance=~\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "evictions"},
        {"refId": "B", "expr": "sum(rate(bicraft_memory_refused_total{instance=~\"$instance\"}[$__rate_interval])) * 60", "legendFormat": "refused"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Spill bytes",
      "description": "Backups moved to temporary files under the memory budget (BICRAFT_SPILL_DIR).",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [{"refId": "A", "expr": "sum(bicraft_spill_bytes{instance=~\"$instance\"})", "legendFormat": "spill"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Aggregation builds",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "sum(bicraft_aggregation_builds_running{instance=~\"$instance\"})", "legendFormat": "running"},
        {"refId": "B", "expr": "sum by (result) (increase(bicraft_aggregation_builds_total{instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "ended {{result}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Queue wait p95, calls running and queued",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(bicraft_queue_wait_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "wait p95 (s)"},
        {"refId": "B", "expr": "sum(bicraft_tool_calls_running{instance=~\"$instance\"})", "legendFormat": "running"},
        {"refId": "C", "expr": "sum(bicraft_tool_calls_queued{instance=~\"$instance\"})", "legendFormat": "queued"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
