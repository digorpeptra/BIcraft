  {"command": "relationship.add", "params": {"name": "Sales_Date", "from": "Sales[Date]", "to": "Date[Date]"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue Total",
    "expression": "SUM(Sales[Revenue])", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Gross Margin",
    "expression": "SUM(Sales[Revenue]) - SUM(Sales[Cost])", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Margin %",
    "expression": "DIVIDE([Gross Margin], [Revenue Total])", "format_string": "0.0%"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Units Sold",
    "expression": "SUM(Sales[Units])", "format_string": "#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue PY",
    "expression": "CALCULATE([Revenue Total], SAMEPERIODLASTYEAR('Date'[Date]))", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue YoY %",
    "expression": "DIVIDE([Revenue Total] - [Revenue PY], [Revenue PY])", "format_string": "+0.0%;-0.0%"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue Target",
    "expression": "[Revenue PY] * 1.12", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Margin Target",
    "expression": "0.38", "format_string": "0.0%"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue YTD",
    "expression": "TOTALYTD([Revenue Total], 'Date'[Date])", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Revenue PY YTD",
    "expression": "CALCULATE([Revenue YTD], SAMEPERIODLASTYEAR('Date'[Date]))", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Margin YTD",
    "expression": "TOTALYTD([Gross Margin], 'Date'[Date])", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Margin PY YTD",
    "expression": "CALCULATE([Margin YTD], SAMEPERIODLASTYEAR('Date'[Date]))", "format_string": "$#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Units YTD",
    "expression": "TOTALYTD([Units Sold], 'Date'[Date])", "format_string": "#,0"}},
  {"command": "measure.add", "params": {"table": "Sales", "name": "Units PY YTD",
    "expression": "CALCULATE([Units YTD], SAMEPERIODLASTYEAR('Date'[Date]))", "format_string": "#,0"}},
